# both silently kept committed code out of the repository.
/engine/h3
/engine/h3_*_tests
/engine/h3_*_test
/engine/libh3.a
.deps/
build/

# ---- models & weights (multi-GB, never commit) ----
# Anchored to the repo root: a bare `models/` would also match
# pipeline/models/, which holds the adapter source code, not weights.
# Found the hard way: the H3 adapter was never committed until 2026-10-25.
/models/
*.safetensors
*.bin
*.gguf

